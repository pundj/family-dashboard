@page "/"
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject DashboardSettingsState DashboardSettingsState
@implements IDisposable

<div class="d-flex align-items-start mt-2">
    <div class="dashboard-tab-sidebar @(_showTabs ? "" : "is-collapsed")">
        <button class="nav-link dashboard-tab-toggle"
                @onclick="ToggleTabs"
                aria-controls="dashboard-tabs"
                aria-expanded="@_showTabs"
                aria-label="@(_showTabs ? "Collapse dashboard tabs" : "Expand dashboard tabs")"
                title="@(_showTabs ? "Collapse dashboard tabs" : "Expand dashboard tabs")">
            <i class="fa-solid fa-bars" aria-hidden="true"></i>
        </button>
        <div id="dashboard-tabs" class="nav flex-column nav-pills mt-2" role="tablist" aria-orientation="vertical">
            @if (_showSmartThingsTab)
            {
                <button class="nav-link dashboard-tab-link @(_activeTab == "smart-home" ? "active" : "")"
                        @onclick='() => ChangeTab("smart-home")'
                        aria-label="Smart Home"
                        title="Smart Home">
                    <i class="fa-solid fa-house" aria-hidden="true"></i>
                    <span class="dashboard-tab-label">Smart Home</span>
                </button>
            }
            @if (_showWeatherTab)
            {
                <button class="nav-link dashboard-tab-link @(_activeTab == "weather" ? "active" : "")"
                        @onclick='() => ChangeTab("weather")'
                        aria-label="Weather"
                        title="Weather">
                    <i class="fa-solid fa-cloud-sun" aria-hidden="true"></i>
                    <span class="dashboard-tab-label">Weather</span>
                </button>
            }
            @if (_showCalendarTab)
            {
                <button class="nav-link dashboard-tab-link @(_activeTab == "calendar" ? "active" : "")"
                        @onclick='() => ChangeTab("calendar")'
                        aria-label="Calendar"
                        title="Calendar">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                    <span class="dashboard-tab-label">Calendar</span>
                </button>
            }
        </div>
        <button class="nav-link dashboard-settings-button mt-2"
                @onclick="DashboardSettingsState.RequestOpen"
                aria-label="Settings"
                title="Settings">
            <i class="fa-solid fa-gear" aria-hidden="true"></i>
            <span class="dashboard-tab-label">Settings</span>
        </button>
    </div>

    <div class="dashboard-tab-content tab-content flex-grow-1">
        @if (_showSmartThingsTab)
        {
            <div class="tab-pane fade @(_activeTab == "smart-home" ? "show active" : "")">
                @if (_activeTab == "smart-home")
                {
                    <SmartHome />
                }
            </div>
        }
        @if (_showWeatherTab)
        {
            <div class="tab-pane fade @(_activeTab == "weather" ? "show active" : "")">
                @if (_activeTab == "weather")
                {
                    <WeatherForecast />
                }
            </div>
        }
        @if (_showCalendarTab)
        {
            <div class="tab-pane fade @(_activeTab == "calendar" ? "show active" : "")">
                @if (_activeTab == "calendar")
                {
                    <Calendar />
                }
            </div>
        }
    </div>
</div>

@code {
    private bool _showSmartThingsTab;
    private bool _showWeatherTab;
    private bool _showCalendarTab;
    private bool _showTabs = true;
    private string _activeTab = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _showSmartThingsTab = true;
        _showWeatherTab = HasWeatherConfiguration();
        _showCalendarTab = Configuration != null &&
            (Configuration.GetValue<string>("GoogleOAuth:ClientId") != null ||
             Configuration.GetValue<string>("GoogleCalendarEmbedCode") != null);

        await LoadActiveTabAsync();
        NavigationManager.LocationChanged += OnLocationChanged;

        await base.OnInitializedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabFromUrl = query["tab"];

        if (!string.IsNullOrEmpty(tabFromUrl))
        {
            _activeTab = IsTabAvailable(tabFromUrl) ? tabFromUrl : GetDefaultTab();
            StateHasChanged();
        }
    }

    private async Task LoadActiveTabAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabFromUrl = query["tab"];

        if (!string.IsNullOrEmpty(tabFromUrl))
        {
            _activeTab = tabFromUrl;
        }
        else
        {
            try
            {
                var storedTab = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "active_tab");
                _activeTab = !string.IsNullOrEmpty(storedTab) ? storedTab : GetDefaultTab();
            }
            catch
            {
                _activeTab = GetDefaultTab();
            }
        }

        if (!IsTabAvailable(_activeTab))
        {
            _activeTab = GetDefaultTab();
        }
    }

    private async Task ChangeTab(string tab)
    {
        if (!IsTabAvailable(tab))
        {
            return;
        }

        _activeTab = tab;
        NavigationManager.NavigateTo($"/?tab={tab}", false);

        try
        {
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", "active_tab", tab);
        }
        catch
        {
        }

        StateHasChanged();
    }

    private bool IsTabAvailable(string tab) => tab switch
    {
        "smart-home" => _showSmartThingsTab,
        "weather" => _showWeatherTab,
        "calendar" => _showCalendarTab,
        _ => false
    };

    private string GetDefaultTab()
    {
        if (_showSmartThingsTab)
        {
            return "smart-home";
        }

        if (_showWeatherTab)
        {
            return "weather";
        }

        if (_showCalendarTab)
        {
            return "calendar";
        }

        return string.Empty;
    }

    private void ToggleTabs()
    {
        _showTabs = !_showTabs;
    }

    private bool HasWeatherConfiguration() =>
        Configuration is not null &&
        Configuration.GetValue<double?>("Weather:Latitude") is not null &&
        Configuration.GetValue<double?>("Weather:Longitude") is not null;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        GC.SuppressFinalize(this);
    }
}
