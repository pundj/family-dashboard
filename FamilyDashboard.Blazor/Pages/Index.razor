@page "/"
@inject IConfiguration Configuration
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject DashboardSettingsState DashboardSettingsState
@implements IDisposable

<div class="d-flex align-items-start mt-2">
    <div class="dashboard-tab-sidebar">
        <button class="btn btn-outline-secondary dashboard-tab-toggle"
                @onclick="ToggleTabs"
                aria-controls="dashboard-tabs"
                aria-expanded="@_showTabs"
                aria-label="@(_showTabs ? "Hide dashboard tabs" : "Show dashboard tabs")">
            <span aria-hidden="true">@(_showTabs ? "◀" : "▶")</span>
        </button>
        @if (_showTabs)
        {
        <div id="dashboard-tabs" class="nav flex-column nav-pills mt-2" role="tablist" aria-orientation="vertical">
            @if (_showSmartThingsTab)
            {
                <button class="nav-link @(_activeTab == "smart-home" ? "active" : "")" 
                        @onclick='() => ChangeTab("smart-home")'>Smart Home</button>
            }
            @if (_showWeatherTab)
            {
                <button class="nav-link @(_activeTab == "weather" ? "active" : "")" 
                        @onclick='() => ChangeTab("weather")'>Weather</button>
            }
            @if (_showCalendarTab)
            {
                <button class="nav-link @(_activeTab == "calendar" ? "active" : "")" 
                        @onclick='() => ChangeTab("calendar")'>Calendar</button>
            }
        </div>
        <button class="btn btn-sm btn-outline-secondary mt-2 w-100"
                @onclick="DashboardSettingsState.RequestOpen">
            <i class="fa-solid fa-gear me-1" aria-hidden="true"></i>
            Settings
        </button>
        }
    </div>
    <div class="dashboard-tab-content tab-content flex-grow-1">
        @if (_showSmartThingsTab)
        {
            <div class="tab-pane fade @(_activeTab == "smart-home" ? "show active" : "")">
                @if (_activeTab == "smart-home")
                {
                    <SmartHome />
                }
            </div>
        }
        @if (_showWeatherTab)
        {
            <div class="tab-pane fade @(_activeTab == "weather" ? "show active" : "")">
                @if (_activeTab == "weather")
                {
                    <WeatherForecast />
                }
            </div>
        }
        @if (_showCalendarTab)
        {
            <div class="tab-pane fade @(_activeTab == "calendar" ? "show active" : "")">
                @if (_activeTab == "calendar")
                {
                    <Calendar/>
                }
            </div>
        }
    </div>
</div>


@code {
    bool _showSmartThingsTab;
    bool _showWeatherTab;
    bool _showCalendarTab;
    bool _showTabs = true;
    string _activeTab = "";

    protected override async Task OnInitializedAsync()
    {
        _showSmartThingsTab = true;
        _showWeatherTab = Configuration != null && Configuration.GetValue<string>("Locale") != null;
        _showCalendarTab = Configuration != null && 
            (Configuration.GetValue<string>("GoogleOAuth:ClientId") != null || 
             Configuration.GetValue<string>("GoogleCalendarEmbedCode") != null);

        // Load active tab from URL or localStorage
        await LoadActiveTabAsync();
        
        NavigationManager.LocationChanged += OnLocationChanged;
        
        await base.OnInitializedAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var uri = new Uri(e.Location);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabFromUrl = query["tab"];
        
        if (!string.IsNullOrEmpty(tabFromUrl))
        {
            _activeTab = tabFromUrl;
            StateHasChanged();
        }
    }

    private async Task LoadActiveTabAsync()
    {
        // Check URL first
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        var tabFromUrl = query["tab"];
        
        if (!string.IsNullOrEmpty(tabFromUrl))
        {
            _activeTab = tabFromUrl;
        }
        else
        {
            // Load from localStorage
            try
            {
                var storedTab = await JsRuntime.InvokeAsync<string>("localStorage.getItem", "active_tab");
                if (!string.IsNullOrEmpty(storedTab))
                {
                    _activeTab = storedTab;
                }
                else
                {
                    // Default to first available tab
                    _activeTab = _showSmartThingsTab ? "smart-home" : 
                                _showWeatherTab ? "weather" : 
                                _showCalendarTab ? "calendar" : "";
                }
            }
            catch
            {
                _activeTab = _showSmartThingsTab ? "smart-home" : 
                            _showWeatherTab ? "weather" : 
                            _showCalendarTab ? "calendar" : "";
            }
        }
    }

    private async void ChangeTab(string tab)
    {
        _activeTab = tab;

        // Update URL
        NavigationManager.NavigateTo($"/?tab={tab}", false);

        // Save to localStorage
        try
        {
            await JsRuntime.InvokeVoidAsync("localStorage.setItem", "active_tab", tab);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving active tab: {ex.Message}");
        }

        StateHasChanged();
    }

    private void ToggleTabs()
    {
        _showTabs = !_showTabs;
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
