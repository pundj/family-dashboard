@inherits LayoutComponentBase
@inject IConfiguration Configuration
@inject IJSRuntime JsRuntime
@inject DashboardSettingsState DashboardSettingsState
@implements IAsyncDisposable

<PageTitle>@_familyName Family Dashboard</PageTitle>
<main>
    @if (_showTopTiles)
    {
        <div class="dashboard-top-tiles row g-2 my-1">
            <div class="col">
                <RandomJoke />
            </div>
            <div class="col">
                <RandomQuote />
            </div>
        </div>
    }
    <article class="content px-2 py-0">
        @Body
    </article>
    <footer class="d-flex justify-content-center">
        <DashboardFooter FamilyName="@_familyName" />
    </footer>
</main>

@if (_showSettings)
{
    <div class="dashboard-settings-modal" @onclick="CloseSettings">
        <div class="dashboard-settings-content" @onclick:stopPropagation="true" role="dialog" aria-modal="true" aria-labelledby="dashboard-settings-title">
            <div class="dashboard-settings-header">
                <h2 id="dashboard-settings-title">Dashboard Settings</h2>
                <button class="btn-close" @onclick="CloseSettings" aria-label="Close settings"></button>
            </div>
            <div class="dashboard-settings-body">
                <div class="form-check mt-3">
                    <input id="show-top-tiles"
                           class="form-check-input"
                           type="checkbox"
                           @bind="_showTopTilesDraft" />
                    <label class="form-check-label" for="show-top-tiles">Show joke and quote tiles</label>
                </div>
                <section class="screensaver-settings mt-4" aria-labelledby="screensaver-settings-title">
                    <h3 id="screensaver-settings-title">Screensaver</h3>
                    <div class="form-check">
                        <input id="show-screensaver"
                               class="form-check-input"
                               type="checkbox"
                               @bind="_showScreensaverDraft" />
                        <label class="form-check-label" for="show-screensaver">Enable screensaver</label>
                    </div>
                    @if (_showScreensaverDraft)
                    {
                        <div class="screensaver-settings-options">
                            <label for="inactivity-timeout" class="form-label">Screen timeout (minutes)</label>
                            <input id="inactivity-timeout"
                                   class="form-control"
                                   type="number"
                                   min="1"
                                   max="1440"
                                   @bind="_inactivityTimeoutDraftMinutes" />
                            <div class="form-text">The screen goes dark after this period of inactivity. Touch the screen to wake it.</div>
                            <div class="form-check mt-3">
                                <input id="show-screensaver-date-time"
                                       class="form-check-input"
                                       type="checkbox"
                                       @bind="_showScreensaverDateTimeDraft" />
                                <label class="form-check-label" for="show-screensaver-date-time">Show date and time</label>
                            </div>
                            @if (_showScreensaverDateTimeDraft)
                            {
                                <div class="mt-3">
                                    <label for="screensaver-date-time-color" class="form-label">Date and time color</label>
                                    <input id="screensaver-date-time-color"
                                           class="form-control form-control-color"
                                           type="color"
                                           @bind="_screensaverDateTimeColorDraft" />
                                </div>
                            }
                        </div>
                    }
                </section>
            </div>
            <div class="dashboard-settings-actions">
                <button class="btn btn-outline-secondary" @onclick="CloseSettings">Cancel</button>
                <button class="btn btn-primary" @onclick="SaveSettingsAsync">Save</button>
            </div>
        </div>
    </div>
}

@code {
    private const int DefaultInactivityTimeoutMinutes = 5;
    private const int MaximumInactivityTimeoutMinutes = 1440;

    private string? _familyName;
    private bool _showSettings;
    private int _inactivityTimeoutMinutes = DefaultInactivityTimeoutMinutes;
    private int _inactivityTimeoutDraftMinutes = DefaultInactivityTimeoutMinutes;
    private bool _showTopTiles = true;
    private bool _showTopTilesDraft = true;
    private bool _showScreensaver;
    private bool _showScreensaverDraft;
    private bool _showScreensaverDateTime;
    private bool _showScreensaverDateTimeDraft;
    private string _screensaverDateTimeColor = DefaultScreensaverDateTimeColor;
    private string _screensaverDateTimeColorDraft = DefaultScreensaverDateTimeColor;

    private const string DefaultScreensaverDateTimeColor = "#d0d0d0";

    protected override void OnInitialized()
    {
        _familyName = Configuration["FamilyName"];
        DashboardSettingsState.OpenRequested += OpenSettings;
        base.OnInitialized();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        var storedTimeout = await JsRuntime.InvokeAsync<string?>("familyDashboard.getInactivityTimeoutMinutes");
        if (int.TryParse(storedTimeout, out var timeout) && timeout is >= 1 and <= MaximumInactivityTimeoutMinutes)
            _inactivityTimeoutMinutes = timeout;

        var storedShowTopTiles = await JsRuntime.InvokeAsync<string?>("familyDashboard.getShowTopTiles");
        if (bool.TryParse(storedShowTopTiles, out var showTopTiles))
            _showTopTiles = showTopTiles;

        var storedShowScreensaver = await JsRuntime.InvokeAsync<string?>("familyDashboard.getShowScreensaver");
        if (storedShowScreensaver is null)
            _showScreensaver = true;
        else if (bool.TryParse(storedShowScreensaver, out var showScreensaver))
            _showScreensaver = showScreensaver;

        var storedShowScreensaverDateTime = await JsRuntime.InvokeAsync<string?>("familyDashboard.getShowScreensaverDateTime");
        if (bool.TryParse(storedShowScreensaverDateTime, out var showScreensaverDateTime))
            _showScreensaverDateTime = showScreensaverDateTime;

        var storedScreensaverDateTimeColor = await JsRuntime.InvokeAsync<string?>("familyDashboard.getScreensaverDateTimeColor");
        if (IsHexColor(storedScreensaverDateTimeColor))
            _screensaverDateTimeColor = storedScreensaverDateTimeColor!;

        _inactivityTimeoutDraftMinutes = _inactivityTimeoutMinutes;
        _showTopTilesDraft = _showTopTiles;
        _showScreensaverDraft = _showScreensaver;
        _showScreensaverDateTimeDraft = _showScreensaverDateTime;
        _screensaverDateTimeColorDraft = _screensaverDateTimeColor;
        await JsRuntime.InvokeVoidAsync("familyDashboard.setShowScreensaver", _showScreensaver);
        await JsRuntime.InvokeVoidAsync("familyDashboard.configureInactivityTimeout", _inactivityTimeoutMinutes);
        await JsRuntime.InvokeVoidAsync("familyDashboard.setShowScreensaverDateTime", _showScreensaverDateTime);
        await JsRuntime.InvokeVoidAsync("familyDashboard.setScreensaverDateTimeColor", _screensaverDateTimeColor);
        StateHasChanged();
    }

    private void OpenSettings()
    {
        _inactivityTimeoutDraftMinutes = _inactivityTimeoutMinutes;
        _showTopTilesDraft = _showTopTiles;
        _showScreensaverDraft = _showScreensaver;
        _showScreensaverDateTimeDraft = _showScreensaverDateTime;
        _screensaverDateTimeColorDraft = _screensaverDateTimeColor;
        _showSettings = true;
        StateHasChanged();
    }

    private void CloseSettings()
    {
        _showSettings = false;
    }

    private async Task SaveSettingsAsync()
    {
        _inactivityTimeoutMinutes = Math.Clamp(
            _inactivityTimeoutDraftMinutes,
            1,
            MaximumInactivityTimeoutMinutes);

        await JsRuntime.InvokeVoidAsync("familyDashboard.setInactivityTimeoutMinutes", _inactivityTimeoutMinutes);
        _showTopTiles = _showTopTilesDraft;
        await JsRuntime.InvokeVoidAsync("familyDashboard.setShowTopTiles", _showTopTiles);
        _showScreensaver = _showScreensaverDraft;
        await JsRuntime.InvokeVoidAsync("familyDashboard.setShowScreensaver", _showScreensaver);
        _showScreensaverDateTime = _showScreensaverDateTimeDraft;
        await JsRuntime.InvokeVoidAsync("familyDashboard.setShowScreensaverDateTime", _showScreensaverDateTime);
        _screensaverDateTimeColor = _screensaverDateTimeColorDraft;
        await JsRuntime.InvokeVoidAsync("familyDashboard.setScreensaverDateTimeColor", _screensaverDateTimeColor);
        _showSettings = false;
    }

    private static bool IsHexColor(string? value) =>
        value is { Length: 7 } && value[0] == '#' && value[1..].All(Uri.IsHexDigit);

    public async ValueTask DisposeAsync()
    {
        DashboardSettingsState.OpenRequested -= OpenSettings;
        await JsRuntime.InvokeVoidAsync("familyDashboard.disposeInactivityTimeout");
    }
}