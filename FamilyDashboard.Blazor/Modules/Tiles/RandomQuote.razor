@inject IRandomQuoteService RandomQuoteService
@using FamilyDashboard.Blazor.Models

@if (_errorMessage != null)
{
    <p class="m-0">@_errorMessage</p>
}
else if (_response == null)
{
    <p>Loading a random quote...</p>
}
else if (_response.Content == null && _response.RandomVerse?.Text != null)
{
    <figure @onclick="async () => await FetchQuoteTextAsync()">
        <blockquote class="blockquote">
            <p>@_response.RandomVerse?.Text</p>
        </blockquote>
        <figcaption class="blockquote-footer">
            @_response.RandomVerse?.Book @_response.RandomVerse?.Chapter:@_response.RandomVerse?.Verse
        </figcaption>
    </figure>
}
else if (_response.Content != null)
{
    <figure @onclick="async () => await FetchQuoteTextAsync()">
      <blockquote class="blockquote">
        <p>@_response.Content</p>
      </blockquote>
      <figcaption class="blockquote-footer">
        @_response.Author
      </figcaption>
    </figure>
}

@code {
    private string? _errorMessage;
    private GetRandomQuoteResponse? _response;
    private Timer? _timer;

    protected override async Task OnInitializedAsync()
    {
        _timer = new System.Threading.Timer(async _ =>
        {
            await FetchQuoteTextAsync();
            await InvokeAsync(StateHasChanged);
        }, null, TimeSpan.Zero, TimeSpan.FromHours(1));

        await base.OnInitializedAsync();
    }

    async Task FetchQuoteTextAsync()
    {
        try
        {
            _response = await RandomQuoteService.GetQuoteAsync();
            StateHasChanged();
        }
        catch
        {
            _errorMessage = "Unable to retrieve a quote.";
        }
    }
}