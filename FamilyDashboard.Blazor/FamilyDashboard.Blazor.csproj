<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.2" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
    <PackageReference Include="Google.Apis.Calendar.v3" Version="1.68.0.*" />
    <PackageReference Include="Google.Apis.Auth" Version="1.68.0" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <ItemGroup Condition=" '$(Configuration)' == 'Release' ">
    <Content Remove="wwwroot\appsettings.Development.json" />
  </ItemGroup>

  <Target Name="BuildFrontendAssets" BeforeTargets="ResolveProjectStaticWebAssets">
    <Exec Command="npm run build"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition=" '$(Configuration)' == 'Debug'" />
    <Exec Command="npm run production"
          WorkingDirectory="$(MSBuildProjectDirectory)"
          Condition=" '$(Configuration)' == 'Release'" />
  </Target>

</Project>
